<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SkillUp – Learn a job-ready skill in 8 weeks</title>
  <style>
    /* 1. DESIGN TOKENS: one palette, defined once, used everywhere */
    :root {
      --ink: #14213d;      /* headings, nav, footer */
      --body: #3d4a5c;     /* body text */
      --paper: #ffffff;
      --mist: #eef3fb;     /* alternate section background */
      --brand: #2f5bea;    /* buttons, links */
      --brand-dark: #1f43b8;
      --sun: #ffb703;      /* accent */
      --radius: 12px;
    }

    /* 2. RESET: border-box means padding never adds to width, so nothing overflows */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; scroll-padding-top: 80px; }
    body {
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      font-size: 1rem;          /* body size */
      line-height: 1.6;
      color: var(--body);
      background: var(--paper);
    }
    h1, h2, h3 { color: var(--ink); line-height: 1.2; }
    h1 { font-size: clamp(2rem, 6vw, 3.5rem); }   /* heading size, scales with screen */
    h2 { font-size: clamp(1.5rem, 4vw, 2.25rem); margin-bottom: 0.5rem; }
    h3 { font-size: 1.15rem; margin-bottom: 0.4rem; }
    a { color: inherit; }

    /* 3. LAYOUT HELPER: centres content and caps its width */
    .wrap { max-width: 1100px; margin: 0 auto; padding: 0 1.25rem; }
    section { padding: 4.5rem 0; }
    .alt { background: var(--mist); }
    .section-intro { max-width: 60ch; margin-bottom: 2.5rem; }

    /* 4. STICKY NAV */
    nav {
      position: sticky; top: 0; z-index: 10;
      background: var(--ink);
    }
    nav .wrap {
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 0.5rem 1.5rem; padding-top: 0.9rem; padding-bottom: 0.9rem;
    }
    .logo { color: var(--paper); font-weight: 800; font-size: 1.3rem; text-decoration: none; }
    .logo span { color: var(--sun); }
    nav ul { display: flex; gap: 1.5rem; list-style: none; flex-wrap: wrap; }
    nav ul a { color: #d6def0; text-decoration: none; font-size: 0.95rem; }
    nav ul a:hover { color: var(--sun); }

    /* 5. BUTTON */
    .btn {
      display: inline-block; padding: 0.9rem 1.8rem;
      background: var(--sun); color: var(--ink);
      font-weight: 700; text-decoration: none; border-radius: var(--radius);
    }
    .btn:hover, .btn:focus-visible { background: #ffc933; }
    a:focus-visible { outline: 3px solid var(--brand); outline-offset: 3px; }

    /* 6. HERO */
    .hero { background: var(--ink); color: #d6def0; padding: 5.5rem 0 6rem; }
    .hero h1 { color: var(--paper); max-width: 18ch; margin-bottom: 1rem; }
    .hero p { max-width: 50ch; font-size: 1.2rem; margin-bottom: 2rem; }

    /* 7. FEATURES: CSS Grid, auto-fits as many columns as space allows */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.5rem;
    }
    .card {
      background: var(--paper); padding: 1.75rem;
      border-radius: var(--radius); border-top: 4px solid var(--brand);
      box-shadow: 0 2px 10px rgba(20, 33, 61, 0.08);
    }

    /* 8. TESTIMONIALS */
    .quote { background: var(--mist); border-left: 4px solid var(--sun); }
    .quote p { font-style: italic; margin-bottom: 1rem; }
    .quote strong { color: var(--ink); }

    /* 9. FOOTER */
    footer { background: var(--ink); color: #d6def0; padding: 3rem 0 2rem; }
    footer .wrap { display: flex; flex-wrap: wrap; gap: 2rem; justify-content: space-between; }
    footer h3 { color: var(--paper); }
    footer ul { list-style: none; }
    footer li { margin-bottom: 0.3rem; }
    footer a { text-decoration: none; }
    footer a:hover { color: var(--sun); }
    .copy { width: 100%; font-size: 0.85rem; border-top: 1px solid #31406a; padding-top: 1.25rem; }

    /* 10. MOBILE TWEAKS */
    @media (max-width: 600px) {
      section { padding: 3rem 0; }
      .hero { padding: 3.5rem 0 4rem; }
      nav ul { gap: 1rem; }
    }
  </style>
</head>
